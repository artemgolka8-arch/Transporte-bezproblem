# PostgreSQL connection string.
# Локально (docker/локальный postgres) или Railway подставит переменную сам,
# если вы используете ссылку на переменную ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/fleet?schema=public"

# Сгенерируйте случайную строку: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# На Railway укажите публичный домен приложения, например:
# https://fleet-manager-production.up.railway.app
NEXTAUTH_URL="http://localhost:3000"

# Данные для первого администратора, которого создаст prisma/seed.ts
SEED_ADMIN_EMAIL="admin@fleet.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Администратор"

# Email — регистрация на https://www.brevo.com, ключ создаётся в
# SMTP & API → API Keys (нужен именно "API Key", не SMTP-логин/пароль)
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Адрес отправителя — должен быть подтверждён в Brevo:
# Senders, Domains & Dedicated IPs → Senders → Add a sender
BREVO_FROM_EMAIL="notifications@your-domain.eu"
# Имя отправителя, которое увидит получатель (необязательно, по умолчанию "BezProblem")
BREVO_FROM_NAME="BezProblem"

# SMS — регистрация на https://panel.smsplanet.pl/register (20 SMS бесплатно на старте)
# Токен создаётся в панели: https://panel.smsplanet.pl/s/api?tab=tab4
SMSPLANET_API_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Имя отправителя по умолчанию (до 11 символов). В интерфейсе при отправке SMS
# можно выбрать "TEST" или "BezProblem" (список — src/lib/smsSenders.ts).
# Пока не подтвердите "BezProblem" в панели SMSPlanet ("Pole nadawcy"), используйте "TEST".
SMSPLANET_SENDER="TEST"

# Раздел "Должники" — синхронизация с ravapi.eu (логин/пароль вашего аккаунта
# в кабинете portal.ravapi.eu). Никогда не коммитьте эти значения в git —
# указывайте их только в .env локально и в Variables на Railway.
RAVAPI_EMAIL="your-account@bezproblem.eu"
RAVAPI_PASSWORD="your-ravapi-password"

# Тех же RAVAPI_EMAIL/RAVAPI_PASSWORD достаточно и для кнопки "Синхронизировать
# с Ravapi" на вкладке "Транспорт" — отдельных переменных не требуется.

# Порог (в zł), выше которого новый должник считается "крупным" и по нему
# менеджерам (ADMIN/MANAGER с настроенным Telegram Chat ID в профиле)
# уходит уведомление в Telegram сразу после синхронизации. По умолчанию 500.
DEBTOR_LARGE_ALERT_THRESHOLD="500"

# Telegram-напоминания о задачах.
# 1. В Telegram напишите @BotFather → /newbot → следуйте инструкциям, получите токен вида 123456:ABC-...
TELEGRAM_BOT_TOKEN="123456:ABC-DEF-your-bot-token"
# 2. Придумайте свою секретную строку — ей будет защищён эндпойнт рассылки напоминаний
CRON_SECRET="change-me-too"
