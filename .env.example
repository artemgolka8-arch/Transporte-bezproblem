# PostgreSQL connection string.
# Локально (docker/локальный postgres) или Railway подставит переменную сам,
# если вы используете ссылку на переменную ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/fleet?schema=public"

# Сгенерируйте случайную строку: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# На Railway укажите публичный домен приложения, например:
# https://fleet-manager-production.up.railway.app
NEXTAUTH_URL="http://localhost:3000"

# Данные для первого администратора, которого создаст prisma/seed.ts
SEED_ADMIN_EMAIL="admin@fleet.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Администратор"
