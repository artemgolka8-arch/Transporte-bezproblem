generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

enum VehicleType {
  BIKE
  SCOOTER
}

enum VehicleStatus {
  AVAILABLE
  WORKSHOP
  RENTED
}

enum VehicleBrand {
  DUOTTS
  LOOK_ROAD
  ONE_SPORT
  FUNBIKE
  INDIANA
  NILOX
  RAVAPI
  HONDA_VISION_110
  HONDA_PCX_125
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(VIEWER)
  firstName String?
  lastName  String?
  phone     String?
  position  String?
  city      String?
  createdAt DateTime @default(now())
}

model Vehicle {
  id                 String        @id @default(cuid())
  code               String        @unique
  name               String
  type               VehicleType
  status             VehicleStatus @default(AVAILABLE)
  brand              VehicleBrand?
  city               String?
  imageUrl           String?
  problemDescription String?
  location           String?
  renter             String?
  renterFirstName    String?
  renterLastName     String?
  renterPhone        String?
  renterEmail        String?
  rentedUntil        DateTime?
  clientId           String?
  client             Client?       @relation(fields: [clientId], references: [id])
  workshopDate       DateTime?
  workshopReason     String?
  workshopMileage    Int?
  workshopCity       String?
  keys               Key[]
  history            StatusLog[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Client {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  phone     String    @unique
  email     String?
  notes     String?
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Key {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  label       String
  isDuplicate Boolean  @default(false)
  holder      String?
  notes       String?
  createdAt   DateTime @default(now())
}

model StatusLog {
  id        String        @id @default(cuid())
  vehicleId String
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  status    VehicleStatus
  note      String?
  userName  String?
  createdAt DateTime      @default(now())
}
