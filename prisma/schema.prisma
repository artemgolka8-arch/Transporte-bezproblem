generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
  // Директор: видит только раздел «Приглашённые клиенты», но всех амбассадоров
  // (выбирает нужного в списке). См. middleware.ts
  DIRECTOR
  // Амбассадор: видит только раздел «Приглашённые клиенты» и только своих клиентов
  AMBASSADOR
  // PR Manager: как MANAGER, но дополнительно может ставить задачи
  // амбассадорам, другим PR-менеджерам, администраторам и директору (см. src/lib/roles.ts)
  PR_MANAGER
}

enum VehicleType {
  BIKE
  SCOOTER
}

enum InvitationType {
  FLEET_PARTNER
  RENT
  FLEET_PARTNER_RENT
}

// Стадия работы с приглашённым клиентом (для колонки/фильтра «Статус»)
enum ReferredClientStatus {
  ACTIVE
  PENDING
  IN_PROGRESS
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  WORKSHOP
  RENTED
}

enum VehicleBrand {
  DUOTTS
  LOOK_ROAD
  ONE_SPORT
  FUNBIKE
  INDIANA
  NILOX
  RAVAPI
  HONDA_VISION_110
  HONDA_PCX_125
}

enum VehicleColor {
  BLACK
  WHITE
  GRAY
  RED
  BLUE
  GREEN
  YELLOW
  ORANGE
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  role           Role     @default(VIEWER)
  firstName      String?
  lastName       String?
  phone          String?
  position       String?
  city           String?
  telegramChatId String?
  avatarUrl      String?  @db.Text
  createdAt      DateTime @default(now())
  createdTasks   Task[]   @relation("TaskCreator")
  assignedTasks  Task[]   @relation("TaskAssignee")
  visibleTasks   Task[]   @relation("TaskParticipants")
  // Приглашённые клиенты, закреплённые за этим пользователем (для роли AMBASSADOR)
  referredClients ReferredClient[] @relation("AmbassadorReferred")
  // Ежедневные отчёты амбассадора о проделанной работе
  reports         Report[]         @relation("ReportAuthor")
  // Выплаты (зарплаты и бонусы), полученные этим сотрудником (вкладка «Зарплаты и бонусы»)
  payrollEntries  PayrollEntry[]   @relation("PayrollRecipient")
}

// Тип выплаты во вкладке «Зарплаты и бонусы»
enum PayrollKind {
  SALARY
  BONUS
  ADVANCE
  OTHER
}

// Как деньги были выданы
enum PayrollMethod {
  BANK_ACCOUNT
  CARD
  CASH
}

// Выплата сотруднику: кому, сколько, каким способом и за что.
// Вкладка доступна только ADMIN и DIRECTOR (см. canAccessPayroll в src/lib/roles.ts).
model PayrollEntry {
  id            String        @id @default(cuid())
  // Получатель из списка сотрудников; null — получатель указан вручную или аккаунт удалён.
  recipientId   String?
  recipient     User?         @relation("PayrollRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  // Имя получателя на момент выплаты — остаётся в истории, даже если аккаунт удалят
  recipientName String
  kind          PayrollKind
  amount        Float
  method        PayrollMethod
  // Номер счёта (для BANK_ACCOUNT) или карты (для CARD)
  accountNumber String?
  description   String
  paidAt        DateTime
  createdByName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([recipientId])
  @@index([paidAt])
}

// Самооценка амбассадора за день, указывается в конце отчёта
enum ReportRating {
  BAD
  NORMAL
  GREAT
  EXCELLENT
}

// Ежедневный отчёт амбассадора о проделанной работе (вкладка «Отчёты»)
model Report {
  id             String       @id @default(cuid())
  authorId       String
  author         User         @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  date           DateTime
  description    String
  hoursWorked    Float
  partnerVisits  Int          @default(0)
  rentVisits     Int          @default(0)
  partnerLeads   Int          @default(0)
  rentLeads      Int          @default(0)
  tiktokVideos   Int          @default(0)
  stories        Int          @default(0)
  // Сколько рилс / TikTok реально ОПУБЛИКОВАНО за день (отдельно от «снято»)
  reelsPublished  Int         @default(0)
  tiktokPublished Int         @default(0)
  selfRating     ReportRating
  // Проверка отчёта (PR-менеджер, директор, администратор):
  // PENDING — ждёт проверки, APPROVED — подтверждён, REJECTED — не подтверждён
  // (тогда в reviewComment написано, что не так и что нужно изменить).
  reviewStatus   ReportReviewStatus @default(PENDING)
  reviewComment  String?
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([authorId])
}

enum ReportReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  OPEN
  DONE
  // Отмечена как невыполненная (с обязательной причиной в notDoneReason) —
  // используется, например, амбассадором при отметке по задаче от PR Manager
  NOT_DONE
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(OPEN)
  dueDate        DateTime?
  reminderAt     DateTime?
  reminderSentAt DateTime?
  creatorId      String
  creator        User       @relation("TaskCreator", fields: [creatorId], references: [id])
  assigneeId     String
  assignee       User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  // Все, кто когда-либо был создателем или исполнителем этой задачи —
  // именно они видят задачу в списке. Пополняется при передаче.
  participants   User[]     @relation("TaskParticipants")
  completedAt    DateTime?
  // Причина, по которой задача отмечена невыполненной (обязательна при status = NOT_DONE)
  notDoneReason  String?
  history        TaskLog[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model TaskLog {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action       String
  fromUserName String?
  toUserName   String?
  note         String?
  userName     String?
  createdAt    DateTime @default(now())
}

model Vehicle {
  id                 String        @id @default(cuid())
  code               String        @unique
  vin                String?
  name               String
  type               VehicleType
  status             VehicleStatus @default(AVAILABLE)
  brand              VehicleBrand?
  color              VehicleColor?
  city               String?
  imageUrl           String?
  problemDescription String?
  location           String?
  renter             String?
  renterFirstName    String?
  renterLastName     String?
  renterPhone        String?
  renterEmail        String?
  rentedUntil        DateTime?
  clientId           String?
  client             Client?       @relation(fields: [clientId], references: [id])
  // Заполняются автоматической синхронизацией с ravapi.eu (см. src/app/api/vehicles/ravapi-sync).
  // renterExternalId — id этой техники в ravapi.eu (Vehicles/GetAll); по нему при следующей
  // синхронизации понимаем, что аренда была оформлена автоматически (а не вручную сотрудником),
  // и можно её закрыть, когда техника пропадёт из списка переданной водителям (vehicleStatus:2).
  renterExternalId   Int?
  ravapiSyncedAt     DateTime?
  workshopDate       DateTime?
  workshopReason     String?
  workshopMileage    Int?
  workshopCity       String?
  keys               Key[]
  history            StatusLog[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Client {
  id        String          @id @default(cuid())
  firstName String
  lastName  String
  phone     String          @unique
  email     String?
  notes     String?
  vehicles  Vehicle[]
  messages  ClientMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ReferredClient {
  id             String                 @id @default(cuid())
  firstName      String
  lastName       String
  phone          String                 @unique
  invitationType InvitationType
  city           String
  link           String?
  status         ReferredClientStatus   @default(PENDING)
  // Амбассадор, который привёл клиента. null — клиент пока ни за кем не закреплён
  ambassadorId   String?
  ambassador     User?                  @relation("AmbassadorReferred", fields: [ambassadorId], references: [id], onDelete: SetNull)
  payouts        ReferredClientPayout[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([ambassadorId])
}

model ReferredClientPayout {
  id               String         @id @default(cuid())
  referredClientId String
  referredClient   ReferredClient @relation(fields: [referredClientId], references: [id], onDelete: Cascade)
  amount           Float
  note             String?
  createdByName    String?
  createdAt        DateTime       @default(now())
}

model ClientMessage {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel   String
  target    String
  body      String
  status    String
  error     String?
  sentBy    String?
  createdAt DateTime @default(now())
}

model Key {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  label       String
  isDuplicate Boolean  @default(false)
  holder      String?
  notes       String?
  createdAt   DateTime @default(now())
}

model StatusLog {
  id        String        @id @default(cuid())
  vehicleId String
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  status    VehicleStatus
  note      String?
  userName  String?
  createdAt DateTime      @default(now())
}

// Снапшот должников, импортируемый вручную (по кнопке "Обновить") из внешней
// системы ravapi.eu. externalId — их id клиента, чтобы при повторной синхронизации
// обновлять запись, а не плодить дубликаты.
model Debtor {
  id                   String    @id @default(cuid())
  externalId           Int       @unique
  firstName            String
  lastName             String
  phoneNumber          String?
  vehicleName          String?
  organisation         String?
  currentBalance       Float
  balanceWithDeposits  Float?
  dateOfFirstUnpaidPayoff DateTime?
  dateOfLastUnpaidPayoff  DateTime?
  debtNotes            String?
  isContactedForDebt   Boolean   @default(false)
  lastSyncedAt         DateTime  @default(now())
  messages             DebtorMessage[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model DebtorMessage {
  id        String   @id @default(cuid())
  debtorId  String
  debtor    Debtor   @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  target    String
  body      String
  status    String
  error     String?
  sentBy    String?
  createdAt DateTime @default(now())
}

// Снапшот итогов на момент каждой синхронизации с ravapi.eu — нужен только для
// карточки "Итого" (сравнение "было -> стало"). totalDebt хранится как положительное
// число (сумма |currentBalance| по должникам с currentBalance < 0).
model DebtorSyncSnapshot {
  id              String   @id @default(cuid())
  prevTotalDebt   Float
  newTotalDebt    Float
  prevDebtorCount Int
  newDebtorCount  Int
  createdAt       DateTime @default(now())
}
