generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

enum VehicleType {
  BIKE
  SCOOTER
}

enum InvitationType {
  FLEET_PARTNER
  RENT
  FLEET_PARTNER_RENT
}

enum VehicleStatus {
  AVAILABLE
  WORKSHOP
  RENTED
}

enum VehicleBrand {
  DUOTTS
  LOOK_ROAD
  ONE_SPORT
  FUNBIKE
  INDIANA
  NILOX
  RAVAPI
  HONDA_VISION_110
  HONDA_PCX_125
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  role           Role     @default(VIEWER)
  firstName      String?
  lastName       String?
  phone          String?
  position       String?
  city           String?
  telegramChatId String?
  createdAt      DateTime @default(now())
  createdTasks   Task[]   @relation("TaskCreator")
  assignedTasks  Task[]   @relation("TaskAssignee")
  visibleTasks   Task[]   @relation("TaskParticipants")
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(OPEN)
  dueDate        DateTime?
  reminderAt     DateTime?
  reminderSentAt DateTime?
  creatorId      String
  creator        User       @relation("TaskCreator", fields: [creatorId], references: [id])
  assigneeId     String
  assignee       User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  // Все, кто когда-либо был создателем или исполнителем этой задачи —
  // именно они видят задачу в списке. Пополняется при передаче.
  participants   User[]     @relation("TaskParticipants")
  completedAt    DateTime?
  history        TaskLog[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model TaskLog {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action       String
  fromUserName String?
  toUserName   String?
  note         String?
  userName     String?
  createdAt    DateTime @default(now())
}

model Vehicle {
  id                 String        @id @default(cuid())
  code               String        @unique
  name               String
  type               VehicleType
  status             VehicleStatus @default(AVAILABLE)
  brand              VehicleBrand?
  city               String?
  imageUrl           String?
  problemDescription String?
  location           String?
  renter             String?
  renterFirstName    String?
  renterLastName     String?
  renterPhone        String?
  renterEmail        String?
  rentedUntil        DateTime?
  clientId           String?
  client             Client?       @relation(fields: [clientId], references: [id])
  workshopDate       DateTime?
  workshopReason     String?
  workshopMileage    Int?
  workshopCity       String?
  keys               Key[]
  history            StatusLog[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Client {
  id        String          @id @default(cuid())
  firstName String
  lastName  String
  phone     String          @unique
  email     String?
  notes     String?
  vehicles  Vehicle[]
  messages  ClientMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ReferredClient {
  id             String                 @id @default(cuid())
  firstName      String
  lastName       String
  phone          String                 @unique
  invitationType InvitationType
  city           String
  payouts        ReferredClientPayout[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model ReferredClientPayout {
  id               String         @id @default(cuid())
  referredClientId String
  referredClient   ReferredClient @relation(fields: [referredClientId], references: [id], onDelete: Cascade)
  amount           Float
  note             String?
  createdByName    String?
  createdAt        DateTime       @default(now())
}

model ClientMessage {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel   String
  target    String
  body      String
  status    String
  error     String?
  sentBy    String?
  createdAt DateTime @default(now())
}

model Key {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  label       String
  isDuplicate Boolean  @default(false)
  holder      String?
  notes       String?
  createdAt   DateTime @default(now())
}

model StatusLog {
  id        String        @id @default(cuid())
  vehicleId String
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  status    VehicleStatus
  note      String?
  userName  String?
  createdAt DateTime      @default(now())
}

// Снапшот должников, импортируемый вручную (по кнопке "Обновить") из внешней
// системы ravapi.eu. externalId — их id клиента, чтобы при повторной синхронизации
// обновлять запись, а не плодить дубликаты.
model Debtor {
  id                   String    @id @default(cuid())
  externalId           Int       @unique
  firstName            String
  lastName             String
  phoneNumber          String?
  vehicleName          String?
  organisation         String?
  currentBalance       Float
  balanceWithDeposits  Float?
  dateOfFirstUnpaidPayoff DateTime?
  dateOfLastUnpaidPayoff  DateTime?
  debtNotes            String?
  isContactedForDebt   Boolean   @default(false)
  lastSyncedAt         DateTime  @default(now())
  messages             DebtorMessage[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model DebtorMessage {
  id        String   @id @default(cuid())
  debtorId  String
  debtor    Debtor   @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  target    String
  body      String
  status    String
  error     String?
  sentBy    String?
  createdAt DateTime @default(now())
}
